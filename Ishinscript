-- NIL EVENT BYPASS FUNCTION
local function getNilInstance(className)
	if typeof(getnilinstances) == "function" then
		for _, v in next, getnilinstances() do
			if v:IsA(className) then
				return v
			end
		end
	end
	return nil
end

-- Nearest Target Locator
local function getClosestEnemy(maxDistance)
	local closest = nil
	local shortestDist = maxDistance
	local localHrp = player.Character and player.Character:FindFirstChild("HumanoidRootPart")
	
	if localHrp then
		for _, enemy in ipairs(Workspace:GetChildren()) do
			if enemy:IsA("Model") and enemy ~= player.Character then
				local enemyHum = enemy:FindFirstChildOfClass("Humanoid")
				local enemyHrp = enemy:FindFirstChild("HumanoidRootPart")
				
				if enemyHum and enemyHrp and enemyHum.Health > 0 then
					local dist = (localHrp.Position - enemyHrp.Position).Magnitude
					if dist < shortestDist then
						shortestDist = dist
						closest = enemy
					end
				end
			end
		end
	end
	return closest
end

local lastAttack = 0
local lastParry = 0
local lastEvade = 0

-- Engine Heartbeat Loop Processing Engine
RunService.RenderStepped:Connect(function()
	local localChar = player.Character
	local localHrp = localChar and localChar:FindFirstChild("HumanoidRootPart")
	local localHum = localChar and localChar:FindFirstChildOfClass("Humanoid")

	if localHrp and localHum then
		-- 1. AUTO SPRINT ASSIST
		if states["Auto Sprint"] and localHum.MoveDirection.Magnitude > 0 then
			if not UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then
				VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.LeftShift, false, game)
			end
		end

		local activeTarget = getClosestEnemy(40)
		if activeTarget then
			local enemyHrp = activeTarget:FindFirstChild("HumanoidRootPart")
			local enemyHum = activeTarget:FindFirstChildOfClass("Humanoid")
			local distance = (localHrp.Position - enemyHrp.Position).Magnitude

			-- 2. CAMERA LOCK-ON SYSTEM
			if states["Camera Lock-On"] then
				local targetPos = enemyHrp.Position + Vector3.new(0, 1.5, 0)
				camera.CFrame = CFrame.lookAt(camera.CFrame.Position, targetPos)
			end

			-- Detect target structural attack indicators
			local isEnemyAttacking = activeTarget:GetAttribute("Attacking") or activeTarget:FindFirstChild("IsStriking") or activeTarget:FindFirstChildOfClass("Tool")

			-- 3. NETWORK LEVEL AUTO PARRY
			if states["Auto Parry"] and distance < 14 and isEnemyAttacking then
				if tick() - lastParry > 0.06 then
					lastParry = tick()
					
					local remoteEvent = getNilInstance("RemoteEvent")
					if remoteEvent then
						pcall(function()
							remoteEvent:FireServer("Block")
						end)
					else
						VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.F, false, game)
						task.wait(0.01)
						VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.F, false, game)
					end
				end
			end

			-- 4. SMART AUTO DODGE / WEAVE ENGINE
			if states["Auto Dodge/Weave"] and distance < 12 and isEnemyAttacking then
				if tick() - lastEvade > 0.15 then
					lastEvade = tick()
					local actionKey = (math.random(1, 2) == 1) and Enum.KeyCode.Q or Enum.KeyCode.X
					VirtualInputManager:SendKeyEvent(true, actionKey, false, game)
					task.wait(0.01)
					VirtualInputManager:SendKeyEvent(false, actionKey, false, game)
				end
			end

			-- 5. COMBAT AUTOMATION ENGINE (Combo Chain & Critical Finisher Loop)
			if states["Combat Automation"] and distance < 11 then
				if tick() - lastAttack > 0.12 then
					lastAttack = tick()
					
					local isPostureBroken = activeTarget:GetAttribute("Stunned") or activeTarget:FindFirstChild("Stunned") or (enemyHum and enemyHum.WalkSpeed < 4)
					
					if isPostureBroken then
						VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
						VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
						task.wait(0.01)
						VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
						VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
					else
						VirtualInputManager:SendMouseButtonEvent(0, 0, 0, true, game, 0)
						task.wait(0.01)
						VirtualInputManager:SendMouseButtonEvent(0, 0, 0, false, game, 0)
					end
				end
			end
		end
	end
end)

